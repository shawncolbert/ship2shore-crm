# ── Client (Vite) — safe to expose, prefixed VITE_ ──────────────────
# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Mapbox public token (pk.…) — powers pickup/drop-off address autocomplete
# and driving-distance calc on /book. Mapbox account → Tokens.
VITE_MAPBOX_TOKEN=YOUR-MAPBOX-PUBLIC-TOKEN

# White-labeling (2026-09-04) — leave ALL FOUR of these unset on the shared
# ship2shorebooking.com site. Only set them on a NEW, separate Netlify site
# you create for one specific client — see README → "Setting up a new
# client's own site". Setting these here would rebrand the login screen,
# browser tab, and "Add to Home Screen" icon for EVERY org still sharing
# this site, not just one.
# VITE_APP_NAME=Acme Dispatch
# VITE_APP_SHORT_NAME=Acme
# VITE_APP_DESCRIPTION=Acme's dispatch CRM — pipeline, contacts, invoices, and calendar.
# VITE_APP_THEME_COLOR=#111f3a

# ── Server (Netlify Functions) — SECRET. Set these in Netlify →
#    Site settings → Environment. For local `netlify dev`, keep them here.
#    Never prefix these with VITE_ and never commit real values. ────────
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=YOUR-SERVICE-ROLE-KEY
ORG_ID=11111111-1111-1111-1111-111111111111

# The Gmail address the inbox sends from and syncs
GMAIL_ADDRESS=you@yourdomain.com

# Google OAuth (see README → "Connecting Gmail")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Claude API key — powers the AI Assistant, draft-reply, business card scan,
# and Lead Finder's site audit/pitch-email drafting. Required for all of these.
ANTHROPIC_API_KEY=

# Lead Finder:
#   FIRECRAWL_API_KEY  — required for "Find website & social media" (web
#                         search for a company's site + Facebook/Instagram/
#                         TikTok/LinkedIn, firecrawl.dev). Also improves the
#                         site-audit step on JS-heavy sites -- without it,
#                         the audit still works via a plain HTML fetch, but
#                         discovery has no fallback and needs this key.
#   SOCRATA_APP_TOKEN   — optional, free signup, raises the FMCSA data
#                         pull's rate limit above the anonymous default.
#   FMCSA_WEBKEY        — required for "Verify a DOT or MC number" (FMCSA's
#                         official QCMobile API) -- free signup at
#                         mobile.fmcsa.dot.gov. The state/company search
#                         below it doesn't need this one.
FIRECRAWL_API_KEY=
SOCRATA_APP_TOKEN=
FMCSA_WEBKEY=
