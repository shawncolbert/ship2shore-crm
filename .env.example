# ── Client (Vite) — safe to expose, prefixed VITE_ ──────────────────
# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Mapbox public token (pk.…) — powers pickup/drop-off address autocomplete
# and driving-distance calc on /book. Mapbox account → Tokens.
VITE_MAPBOX_TOKEN=YOUR-MAPBOX-PUBLIC-TOKEN

# ── Server (Netlify Functions) — SECRET. Set these in Netlify →
#    Site settings → Environment. For local `netlify dev`, keep them here.
#    Never prefix these with VITE_ and never commit real values. ────────
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=YOUR-SERVICE-ROLE-KEY
ORG_ID=11111111-1111-1111-1111-111111111111

# The Gmail address the inbox sends from and syncs
GMAIL_ADDRESS=you@yourdomain.com

# Google OAuth (see README → "Connecting Gmail")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Claude API key — powers the AI Assistant, draft-reply, business card scan,
# and Lead Finder's site audit/pitch-email drafting. Required for all of these.
ANTHROPIC_API_KEY=

# Lead Finder — FIRECRAWL_API_KEY and SOCRATA_APP_TOKEN are optional, both
# improve results but the tool works without them. FMCSA_WEBKEY is required
# for "Verify a DOT or MC number" specifically (the state/company search
# below it doesn't need it):
#   FIRECRAWL_API_KEY  — cleaner website scraping for the audit step,
#                         especially JS-heavy sites (firecrawl.dev). Without
#                         it, a plain HTML fetch is used instead.
#   SOCRATA_APP_TOKEN   — free signup, raises the FMCSA data pull's rate
#                         limit above the anonymous default.
#   FMCSA_WEBKEY        — free signup at mobile.fmcsa.dot.gov, powers the
#                         DOT/MC verify lookup (FMCSA's QCMobile API).
FIRECRAWL_API_KEY=
SOCRATA_APP_TOKEN=
FMCSA_WEBKEY=
